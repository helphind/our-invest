generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?        @unique
  isActive      Boolean        @default(true)
  userId        String?        @unique
  joinedAt      DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contributions Contribution[]
  loans         Loan[]
  approvals     LoanApproval[]
  loanRequests  LoanRequest[]
  user          User?          @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([phone])
  @@index([isActive])
}

model User {
  id               String    @id @default(uuid())
  name             String
  password         String
  role             Role      @default(MEMBER)
  createdAt        DateTime  @default(now())
  username         String    @unique
  resetToken       String?
  resetTokenExpiry DateTime?
  member           Member?
}

model Contribution {
  id        String             @id @default(uuid())
  memberId  String
  amount    Decimal            @db.Decimal(12, 2)
  month     DateTime
  status    ContributionStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, month])
  @@index([memberId])
  @@index([month])
  @@index([status])
}

model Loan {
  id                 String     @id @default(uuid())
  memberId           String
  principal          Decimal    @default(0) @db.Decimal(14, 2)
  interestRate       Decimal    @default(8.0) @db.Decimal(5, 2)
  durationMonths     Int
  emiAmount          Decimal    @db.Decimal(12, 2)
  loanType           LoanType   @default(NORMAL)
  status             LoanStatus @default(ACTIVE)
  startDate          DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  remainingPayable   Decimal    @default(0) @db.Decimal(14, 2)
  remainingPrincipal Decimal    @default(0) @db.Decimal(14, 2)
  totalPayable       Decimal    @default(0) @db.Decimal(14, 2)
  emis               EMI[]
  member             Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([status])
}

model EMI {
  id            String    @id @default(uuid())
  loanId        String
  installmentNo Int
  amount        Decimal   @db.Decimal(12, 2)
  principal     Decimal   @db.Decimal(12, 2)
  interest      Decimal   @db.Decimal(12, 2)
  dueDate       DateTime
  paidDate      DateTime?
  status        EMIStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  loan          Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, installmentNo])
  @@index([loanId])
  @@index([status])
  @@index([dueDate])
}

model LoanRequest {
  id        String            @id @default(uuid())
  memberId  String
  amount    Decimal           @db.Decimal(14, 2)
  loanType  LoanType          @default(NORMAL)
  status    LoanRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  deletedAt DateTime?
  isDeleted Boolean           @default(false)
  approvals LoanApproval[]
  member    Member            @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([status])
}

model LoanApproval {
  id            String      @id @default(uuid())
  loanRequestId String
  memberId      String
  approved      Boolean
  comment       String?
  createdAt     DateTime    @default(now())
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id])
  member        Member      @relation(fields: [memberId], references: [id])

  @@unique([loanRequestId, memberId])
}

model FundConfig {
  id             String    @id @default(uuid())
  monthlyAmount  Float
  isAutoGenerate Boolean   @default(true)
  lastRunAt      DateTime?
}

enum Role {
  ADMIN
  MEMBER
}

enum ContributionStatus {
  PENDING
  PAID
  OVERDUE
  SKIPPED
  WAIVED
}

enum LoanStatus {
  ACTIVE
  HOLD
  CLOSED
}

enum LoanRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
}

enum EMIStatus {
  PENDING
  PAID
  OVERDUE
}

enum LoanType {
  NORMAL
  INSTANT
}
