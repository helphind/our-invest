generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String? @unique
  isActive Boolean @default(true)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  contributions Contribution[]
  loans         Loan[]
  loanRequests  LoanRequest[]
  approvals     LoanApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([isActive])
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(MEMBER)

  createdAt DateTime @default(now())

  member Member?
}

model Contribution {
  id       String  @id @default(uuid())
  memberId String
  amount   Decimal @db.Decimal(12, 2)

  // store first day of month
  month  DateTime
  status ContributionStatus @default(PENDING)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, month])
  @@index([memberId])
  @@index([month])
  @@index([status])
}

model Loan {
  id       String @id @default(uuid())
  memberId String

  principal    Decimal @db.Decimal(14, 2)
  interestRate Decimal @db.Decimal(5, 2)

  totalAmount     Decimal @db.Decimal(14, 2)
  remainingAmount Decimal @db.Decimal(14, 2)

  durationMonths Int
  emiAmount      Decimal @db.Decimal(12, 2)

  loanType LoanType   @default(NORMAL)
  status   LoanStatus @default(ACTIVE)

  startDate DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  emis     EMI[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([status])
}

model EMI {
  id            String @id @default(uuid())
  loanId        String
  installmentNo Int

  amount    Decimal @db.Decimal(12, 2)
  principal Decimal @db.Decimal(12, 2)
  interest  Decimal @db.Decimal(12, 2)

  dueDate  DateTime
  paidDate DateTime?

  status EMIStatus @default(PENDING)

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loanId, installmentNo])
  @@index([loanId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id     String  @id @default(uuid())
  loanId String
  emiId  String?

  amount   Decimal  @db.Decimal(12, 2)
  paidDate DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id])
  emi  EMI? @relation(fields: [emiId], references: [id])

  createdAt DateTime @default(now())

  @@index([loanId])
  @@index([emiId])
}

model LoanRequest {
  id       String @id @default(uuid())
  memberId String

  amount Decimal @db.Decimal(14, 2)

  loanType LoanType          @default(NORMAL)
  status   LoanRequestStatus @default(PENDING)

  approvals LoanApproval[]

  member Member @relation(fields: [memberId], references: [id])

  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([status])
}

model LoanApproval {
  id            String @id @default(uuid())
  loanRequestId String
  memberId      String

  approved Boolean
  comment  String?

  createdAt DateTime @default(now())

  loanRequest LoanRequest @relation(fields: [loanRequestId], references: [id])
  member      Member      @relation(fields: [memberId], references: [id])

  @@unique([loanRequestId, memberId])
}

enum Role {
  ADMIN
  MEMBER
}

enum ContributionStatus {
  PENDING
  PAID
  OVERDUE
}

enum LoanStatus {
  ACTIVE
  HOLD
  CLOSED
}

enum LoanRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
}

enum EMIStatus {
  PENDING
  PAID
  OVERDUE
}

enum LoanType {
  NORMAL
  INSTANT
}
